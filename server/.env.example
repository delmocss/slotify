# Copia este archivo a ".env" y rellena los valores reales. ".env" nunca se commitea.
PORT=4000
# Cadena de conexion de Postgres (Supabase: Connect -> Transaction pooler)
DATABASE_URL=postgresql://usuario:contrasena@host:6543/postgres
# Secreto para firmar los JWT. Genera uno con:  openssl rand -base64 48
JWT_SECRET=
# Origen permitido por CORS (el frontend). Varios separados por comas.
CORS_ORIGIN=http://localhost:5173
